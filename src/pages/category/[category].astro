---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export function slugify(text: string) {
  if (!text) return 'other';
  return text
    .toLowerCase()
    .replace(/^lada\s+/i, '')
    .trim()
    .replace(/[^a-z0-9а-яё\s-]/gi, '')
    .replace(/\s+/g, '-') || 'other';
}

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const categories = [...new Set(docs.map(doc => doc.data.category))].filter(Boolean);

  return categories.map(cat => ({
    params: { category: slugify(cat) },
    props: {
      categoryName: cat,
      docs: docs.filter(doc => doc.data.category === cat).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { categoryName, docs } = Astro.props;
const allDocs = await getCollection('docs');
const categories = [...new Set(allDocs.map(doc => doc.data.category))].filter(Boolean);
const searchData = allDocs.map(doc => ({ title: doc.data.title, slug: doc.slug, category: doc.data.category }));
const plural = (n: number, one: string, few: string, many: string) => {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
  return many;
};
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={`Материалы по ${categoryName}`} category={categoryName} categories={categories} searchData={searchData} wide>
	<nav class="breadcrumbs breadcrumbs-wide">
		<a href="/">Главная</a><span class="breadcrumb-sep">›</span><span class="breadcrumb-current">{categoryName}</span>
	</nav>

	<section class="hero hero-category">
		<h1>{categoryName}</h1>
		<p>{docs.length} {plural(docs.length, 'инструкция', 'инструкции', 'инструкций')} по обслуживанию и ремонту</p>
		<div class="hero-search search-box">
			<div class="search-input-wrapper">
				<span class="search-icon">🔍</span>
				<input type="text" id="searchInput" placeholder="Поиск по всем статьям..." autocomplete="off" />
			</div>
			<div id="searchResults" class="search-dropdown"></div>
		</div>
	</section>

	<section class="home-section">
		<div class="grid">
			{docs.map(post => (
				<a href={`/docs/${post.slug}`} class="card">
					<span class="badge">{post.data.category}</span>
					<h3>{post.data.title}</h3>
					<p class="card-desc">{post.data.description}</p>
					<span class="card-foot"><span>{fmt(post.data.pubDate)}</span><span class="card-more">Читать →</span></span>
				</a>
			))}
		</div>
	</section>
</Layout>
