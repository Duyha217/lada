---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

// Всё «тяжёлое» (список категорий, похожие статьи) считаем ОДИН раз здесь,
// а не заново на каждой из тысяч страниц — иначе сборка упирается в память.
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const categories = [...new Set(docs.map(d => d.data.category))];

  // группируем статьи по категориям один раз
  const byCat = new Map();
  for (const d of docs) {
    if (!byCat.has(d.data.category)) byCat.set(d.data.category, []);
    byCat.get(d.data.category).push(d);
  }

  // Сколько статей в блоке «Читайте также» (в боковой колонке показываются первые 5 из них)
  const RELATED_COUNT = 8;

  // Для каждой статьи берём «соседей» по списку её категории (следующие по кругу).
  // Так ссылки распределяются по всем статьям, а не достаются всегда одним и тем же.
  const relatedById = new Map();
  for (const arr of byCat.values()) {
    const n = arr.length;
    for (let i = 0; i < n; i++) {
      const picked = [];
      for (let k = 1; k < n && picked.length < RELATED_COUNT; k++) {
        const d = arr[(i + k) % n];
        picked.push({ slug: d.id, data: { title: d.data.title, description: d.data.description, category: d.data.category } });
      }
      relatedById.set(arr[i].id, picked);
    }
  }

  return docs.map(entry => ({
    params: { slug: entry.id },
    props: { entry, related: relatedById.get(entry.id) || [], categories },
  }));
}

const { entry, related, categories } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	category={entry.data.category}
	headings={headings}
	related={related}
	categories={categories}
	pubDate={entry.data.pubDate}
>
	<Content />
</Layout>
