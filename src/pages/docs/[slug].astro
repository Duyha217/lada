---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Получаем похожие статьи из той же категории
const allDocs = await getCollection('docs');
const relatedDocs = allDocs
  .filter(doc => doc.data.category === entry.data.category && doc.slug !== entry.slug)
  .slice(0, 5);

// Подготавливаем данные всех статей для поиска в сайдбаре
const searchData = allDocs.map(doc => ({
  title: doc.data.title,
  slug: doc.slug,
  category: doc.data.category
}));
---

<Layout 
	title={entry.data.title} 
	description={entry.data.description} 
	category={entry.data.category}
	headings={headings}
	related={relatedDocs}
	searchData={searchData}
>
	<Content />
</Layout>
