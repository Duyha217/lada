---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	category?: string;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	related?: Array<any>;
	searchData?: Array<{ title: string; slug: string; category: string }>;
	categories?: Array<string>;
	pubDate?: Date;
	wide?: boolean;
}

const { 
	title, 
	description = "Справочник по ремонту и обслуживанию LADA", 
	category = "Granta",
	headings = [],
	related = [],
	searchData = [],
	categories = ["Granta", "Vesta", "Largus", "Kalina", "Priora", "Niva Legend"],
	pubDate,
	wide = false
} = Astro.props;

const filteredHeadings = headings.filter(h => h.depth === 2);

const slugify = (text: string) => {
  if (!text) return 'other';
  return text.toLowerCase().replace(/^lada\s+/i, '').trim().replace(/[^a-z0-9а-яё\s-]/gi, '').replace(/\s+/g, '-') || 'other';
};
const getCategoryUrl = (cat: string) => `/category/${slugify(cat)}/`;
---

<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Лада Справка</title>
		<meta name="description" content={description} />
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27><text y=%27.9em%27 font-size=%2790%27>🛠</text></svg>" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="ru_RU" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="logo">
					<span class="logo-icon">🛠</span>
					<span>Лада Справка</span>
				</a>
				<button class="mobile-menu-btn" id="menuBtn" aria-label="Меню" aria-expanded="false">☰</button>
				<nav class="main-nav" id="mainNav">
					<a href="/" class="nav-link">📁 Главная</a>
					<a href={getCategoryUrl("LADA Granta")} class="nav-link">Granta</a>
					<a href={getCategoryUrl("LADA Vesta")} class="nav-link">Vesta</a>
					<a href={getCategoryUrl("LADA Largus")} class="nav-link">Largus</a>
					<a href={getCategoryUrl("LADA Kalina")} class="nav-link">Kalina</a>

					<div class="nav-dropdown">
						<button class="dropdown-toggle">📂 Все разделы ▾</button>
						<div class="dropdown-menu">
							{categories.map(cat => (
								<a href={getCategoryUrl(cat)} class="dropdown-item">📁 {cat}</a>
							))}
						</div>
					</div>
				</nav>
			</div>
		</header>

		{!wide && (
		<nav class="breadcrumbs">
			<div class="container">
				<a href="/">Главная</a>
				<span class="breadcrumb-sep">›</span>
				<a href={getCategoryUrl(category)}>{category}</a>
				<span class="breadcrumb-sep">›</span>
				<span class="breadcrumb-current">{title}</span>
			</div>
		</nav>
		)}

		<main class="site-main">
			<div class="container">
				<div class={wide ? 'page-wide' : 'article-layout'}>
					<article class={wide ? 'wide-content' : 'article-main'} data-date={pubDate ? pubDate.toISOString() : undefined}>
						<div class={wide ? undefined : 'article-body'}>
							{!wide && filteredHeadings.length > 0 && (
								<nav class="mobile-toc"><details><summary>📋 Содержание</summary>
									<ul>{filteredHeadings.map(h => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}</ul>
								</details></nav>
							)}
							<slot />
						</div>
					</article>

					{!wide && (
					<aside class="article-sidebar">
						<!-- Поиск с подсказками -->
						<div class="sidebar-box search-box">
							<div class="search-input-wrapper">
								<span class="search-icon">🔍</span>
								<input type="text" id="searchInput" placeholder="Поиск статей..." autocomplete="off" />
							</div>
							<div id="searchResults" class="search-dropdown"></div>
						</div>

						<div class="sidebar-sticky">
						{filteredHeadings.length > 0 && (
							<div class="sidebar-box toc-box">
								<h3 class="sidebar-title orange">СОДЕРЖАНИЕ</h3>
								<nav class="toc-list">
									{filteredHeadings.map(h => (
										<a href={`#${h.slug}`} class="toc-item">{h.text}</a>
									))}
								</nav>
							</div>
						)}

						{related.length > 0 && (
							<div class="sidebar-box related-box">
								<h3 class="sidebar-title orange">ПОХОЖИЕ СТАТЬИ</h3>
								<div class="related-list">
									{related.map(item => (
										<a href={`/docs/${item.slug}`} class="related-item">
											{item.data.title}
										</a>
									))}
								</div>
							</div>
						)}
						</div>
					</aside>
					)}
				</div>
			</div>
		</main>

		{related.length > 0 && (
			<section class="related-bottom">
				<div class="container">
					<h2 class="related-bottom-heading">📖 Читайте также</h2>
					<div class="related-bottom-grid">
						{related.map(item => (
							<a href={`/docs/${item.slug}`} class="related-bottom-card">
								<span class="related-bottom-title">{item.data.title}</span>
								<span class="related-bottom-desc">{item.data.description.length > 110 ? item.data.description.slice(0, 107) + '…' : item.data.description}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)}

		<footer class="site-footer-premium">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-col">
						<div class="footer-brand">🛠 Лада Справка</div>
						<p class="footer-about">Справочник по обслуживанию и самостоятельному ремонту автомобилей LADA: пошаговые инструкции, схемы, расшифровка ошибок и полезные советы.</p>
					</div>
					<div class="footer-col">
						<h4>Разделы</h4>
						<ul>
							{categories.slice(0, 6).map(cat => (<li><a href={getCategoryUrl(cat)}>📁 {cat}</a></li>))}
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p>© 2026 Лада Справка. Все права защищены.</p>

					<!-- Счетчик LiveInternet -->
					<div style="margin-top:10px;">
						<a href="https://www.liveinternet.ru/click" target="_blank">
							<img id="licnt6751" width="88" height="15" style="border:0" 
							title="LiveInternet: показано число посетителей за сегодня"
							src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAEALAAAAAABAAEAAAIBTAA7"
							alt=""/>
						</a>
						<script is:inline>
							(function(d,s){d.getElementById("licnt6751").src=
							"https://counter.yadro.ru/hit?t23.4;r"+escape(d.referrer)+
							((typeof(s)=="undefined")?"":";s"+s.width+"*"+s.height+"*"+
							(s.colorDepth?s.colorDepth:s.pixelDepth))+";u"+escape(d.URL)+
							";h"+escape(d.title.substring(0,150))+";"+Math.random()})(document,screen)
						</script>
					</div>
				</div>
			</div>
		</footer>

		<div id="cookie-consent" class="cookie-popup">
			<div class="cookie-inner">
				<span>🍪 Мы используем файлы cookie для улучшения работы сайта.</span>
				<button id="cookie-accept" class="cookie-btn" type="button">Принять</button>
			</div>
		</div>

		<!-- Скрипт живого поиска -->
		<script is:inline define:vars={{ searchData }}>
	const searchInput = document.getElementById('searchInput');
	const searchResults = document.getElementById('searchResults');

	// Карта автозамены русских названий на английские и наоборот
	const autoSynonyms = {
		'гранта': 'granta', 'гранту': 'granta', 'гранте': 'granta',
		'веста': 'vesta', 'весту': 'vesta', 'весте': 'vesta',
		'калина': 'kalina', 'калину': 'kalina', 'калине': 'kalina',
		'ларгус': 'largus', 'ларгусе': 'largus',
		'приора': 'priora', 'приору': 'priora', 'приоре': 'priora',
		'нива': 'niva', 'ниву': 'niva', 'ниве': 'niva',
		'иксрей': 'xray', 'хрей': 'xray',
		'жигули': 'zhiguli', 'самара': 'samara'
	};

	if (searchInput && searchResults && searchData) {
		searchInput.addEventListener('input', (e) => {
			let query = e.target.value.toLowerCase().trim();
			
			if (query.length < 2) {
				searchResults.style.display = 'none';
				return;
			}

			// Разбиваем запрос на слова
			const words = query.split(/\s+/);

			const matches = searchData.filter(item => {
				const title = item.title.toLowerCase();
				
				// Проверяем каждое слово: ищем как само слово, так и его английский аналог
				return words.every(word => {
					const englishTranslation = autoSynonyms[word];
					if (englishTranslation && title.includes(englishTranslation)) {
						return true;
					}
					return title.includes(word);
				});
			}).slice(0, 8);

			if (matches.length > 0) {
				searchResults.innerHTML = matches.map(m => `
					<a href="/docs/${m.slug}" class="search-result-item">
						📁 ${m.title}
					</a>
				`).join('');
				searchResults.style.display = 'block';
			} else {
				searchResults.innerHTML = '<div style="padding: 0.6rem 0.8rem; font-size: 0.85rem; color: #64748b;">Ничего не найдено</div>';
				searchResults.style.display = 'block';
			}
		});

		document.addEventListener('click', (e) => {
			if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
				searchResults.style.display = 'none';
			}
		});
	}
</script>
		<script is:inline src="/static/main.js" defer></script>
	</body>
</html>
