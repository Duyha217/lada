---
interface Props {
	title: string;
	description?: string;
	category?: string;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	related?: Array<any>;
	searchData?: Array<{ title: string; slug: string; category: string }>;
	categories?: Array<string>;
}

const { 
	title, 
	description = "Справочник по ремонту и обслуживанию LADA", 
	category = "Granta",
	headings = [],
	related = [],
	searchData = [],
	categories = ["Granta", "Vesta", "Largus", "Kalina", "Priora", "Niva Legend"]
} = Astro.props;

const filteredHeadings = headings.filter(h => h.depth === 2);

const slugify = (text: string) => {
  if (!text) return 'other';
  return text.toLowerCase().replace(/^lada\s+/i, '').trim().replace(/[^a-z0-9а-яё\s-]/gi, '').replace(/\s+/g, '-') || 'other';
};
const getCategoryUrl = (cat: string) => `/category/${slugify(cat)}/`;
---

<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Лада Справка</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="logo">
					<span class="logo-icon">🛠</span>
					<span>Лада Справка</span>
				</a>
				<nav class="main-nav">
					<a href="/" class="nav-link">📁 Главная</a>
					<a href={getCategoryUrl("LADA Granta")} class="nav-link">Granta</a>
					<a href={getCategoryUrl("LADA Vesta")} class="nav-link">Vesta</a>
					<a href={getCategoryUrl("LADA Largus")} class="nav-link">Largus</a>
					<a href={getCategoryUrl("LADA Kalina")} class="nav-link">Kalina</a>

					<div class="nav-dropdown">
						<button class="dropdown-toggle">📂 Все разделы ▾</button>
						<div class="dropdown-menu">
							{categories.map(cat => (
								<a href={getCategoryUrl(cat)} class="dropdown-item">📁 {cat}</a>
							))}
						</div>
					</div>
				</nav>
			</div>
		</header>

		<nav class="breadcrumbs">
			<div class="container">
				<a href="/">Главная</a>
				<span class="breadcrumb-sep">›</span>
				<a href={getCategoryUrl(category)}>{category}</a>
				<span class="breadcrumb-sep">›</span>
				<span class="breadcrumb-current">{title}</span>
			</div>
		</nav>

		<main class="site-main">
			<div class="container">
				<div class="article-layout">
					<article class="article-main">
						<slot />
					</article>

					<aside class="article-sidebar">
						<!-- Поиск с подсказками -->
						<div class="sidebar-box search-box">
							<div class="search-input-wrapper">
								<span class="search-icon">🔍</span>
								<input type="text" id="searchInput" placeholder="Поиск статей..." autocomplete="off" />
							</div>
							<div id="searchResults" class="search-dropdown"></div>
						</div>

						{filteredHeadings.length > 0 && (
							<div class="sidebar-box toc-box">
								<h3 class="sidebar-title orange">СОДЕРЖАНИЕ</h3>
								<nav class="toc-list">
									{filteredHeadings.map(h => (
										<a href={`#${h.slug}`} class="toc-item">{h.text}</a>
									))}
								</nav>
							</div>
						)}

						{related.length > 0 && (
							<div class="sidebar-box related-box">
								<h3 class="sidebar-title orange">ПОХОЖИЕ СТАТЬИ</h3>
								<div class="related-list">
									{related.map(item => (
										<a href={`/docs/${item.slug}`} class="related-item">
											{item.data.title}
										</a>
									))}
								</div>
							</div>
						)}
					</aside>
				</div>
			</div>
		</main>

		<footer class="site-footer-premium">
			<div class="container">
				<div class="footer-bottom">
					<p>© 2026 Лада Справка. Все права защищены.</p>
				</div>
			</div>
		</footer>

		<!-- Скрипт живого поиска -->
		<script is:inline define:vars={{ searchData }}>
	const searchInput = document.getElementById('searchInput');
	const searchResults = document.getElementById('searchResults');

	// Карта автозамены русских названий на английские и наоборот
	const autoSynonyms = {
		'гранта': 'granta', 'гранту': 'granta', 'гранте': 'granta',
		'веста': 'vesta', 'весту': 'vesta', 'весте': 'vesta',
		'калина': 'kalina', 'калину': 'kalina', 'калине': 'kalina',
		'ларгус': 'largus', 'ларгусе': 'largus',
		'приора': 'priora', 'приору': 'priora', 'приоре': 'priora',
		'нива': 'niva', 'ниву': 'niva', 'ниве': 'niva',
		'иксрей': 'xray', 'хрей': 'xray',
		'жигули': 'zhiguli', 'самара': 'samara'
	};

	if (searchInput && searchResults && searchData) {
		searchInput.addEventListener('input', (e) => {
			let query = e.target.value.toLowerCase().trim();
			
			if (query.length < 2) {
				searchResults.style.display = 'none';
				return;
			}

			// Разбиваем запрос на слова
			const words = query.split(/\s+/);

			const matches = searchData.filter(item => {
				const title = item.title.toLowerCase();
				
				// Проверяем каждое слово: ищем как само слово, так и его английский аналог
				return words.every(word => {
					const englishTranslation = autoSynonyms[word];
					if (englishTranslation && title.includes(englishTranslation)) {
						return true;
					}
					return title.includes(word);
				});
			}).slice(0, 8);

			if (matches.length > 0) {
				searchResults.innerHTML = matches.map(m => `
					<a href="/docs/${m.slug}" class="search-result-item">
						📁 ${m.title}
					</a>
				`).join('');
				searchResults.style.display = 'block';
			} else {
				searchResults.innerHTML = '<div style="padding: 0.6rem 0.8rem; font-size: 0.85rem; color: #64748b;">Ничего не найдено</div>';
				searchResults.style.display = 'block';
			}
		});

		document.addEventListener('click', (e) => {
			if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
				searchResults.style.display = 'none';
			}
		});
	}
</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #ea580c;
		--primary-hover: #c2410c;
		--bg: #f8fafc;
		--text: #1e293b;
		--card-bg: #ffffff;
		--border: #e2e8f0;
	}
	* { box-sizing: border-box; margin: 0; padding: 0; }
	body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
	.container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
	
	.site-header { background: #ffffff; border-bottom: 1px solid var(--border); padding: 1rem 0; position: sticky; top: 0; z-index: 100; }
	.header-inner { display: flex; justify-content: space-between; align-items: center; }
	.logo { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 1.3rem; color: #ea580c; text-decoration: none; }
	.main-nav { display: flex; align-items: center; gap: 1.2rem; }
	.nav-link { color: #475569; text-decoration: none; font-weight: 600; font-size: 0.95rem; }
	.nav-link:hover { color: var(--primary); }

	.nav-dropdown { position: relative; display: inline-block; }
	.dropdown-toggle { background: none; border: none; cursor: pointer; font: inherit; font-weight: 600; color: #475569; padding: 0.5rem 0.75rem; border-radius: 8px; transition: background 0.2s; }
	.dropdown-toggle:hover { color: var(--primary); background: #fff7ed; }
	.dropdown-menu { display: none; position: absolute; right: 0; top: 100%; min-width: 220px; max-height: 60vh; overflow-y: auto; background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); padding: 0.5rem 0; z-index: 1000; }
	.nav-dropdown:hover .dropdown-menu { display: block; }
	.dropdown-item { display: block; padding: 0.5rem 1rem; color: #334155; text-decoration: none; font-size: 0.9rem; transition: background 0.15s; }
	.dropdown-item:hover { background: #fff7ed; color: #ea580c; }

	.breadcrumbs { background: transparent; padding: 1rem 0; font-size: 0.85rem; color: #64748b; }
	.breadcrumbs a { color: #64748b; text-decoration: none; }
	.breadcrumb-sep { margin: 0 0.4rem; color: #cbd5e1; }
	.breadcrumb-current { color: #1e293b; font-weight: 500; }

	.article-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; }
	@media (max-width: 900px) { .article-layout { grid-template-columns: 1fr; } }

	.article-main { background: #fff; padding: 2.5rem; border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); }
	.article-main h1 { font-size: 2.1rem; font-weight: 800; line-height: 1.25; margin-bottom: 1.5rem; color: #0f172a; }
	.article-main > p:first-of-type::first-letter { font-size: 3.2rem; font-weight: 800; float: left; line-height: 1; margin-right: 0.5rem; color: #ea580c; }
	.article-main h2 { font-size: 1.35rem; font-weight: 700; margin: 2rem 0 1rem 0; color: #0f172a; border-bottom: 2px solid #ea580c; padding-bottom: 0.4rem; }
	.article-main p { margin-bottom: 1.2rem; font-size: 1.05rem; color: #334155; }
	.article-main ul { list-style: none; margin: 1rem 0 1.5rem 0; }
	.article-main ul li { position: relative; padding-left: 1.5rem; margin-bottom: 0.6rem; color: #334155; }
	.article-main ul li::before { content: "🔸"; position: absolute; left: 0; font-size: 0.8rem; top: 2px; }

	.sidebar-box { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.25rem; }
	.sidebar-title.orange { font-size: 0.85rem; font-weight: 800; color: #ea580c; margin-bottom: 1rem; }

	.search-box { position: relative; }
	.search-input-wrapper { display: flex; align-items: center; background: #f8fafc; border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 0.75rem; }
	.search-input-wrapper input { border: none; background: transparent; outline: none; width: 100%; margin-left: 0.5rem; font-size: 0.9rem; }
	.search-dropdown { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 50; margin-top: 4px; overflow: hidden; }
	.search-result-item { display: block; padding: 0.6rem 0.8rem; color: #334155; text-decoration: none; font-size: 0.85rem; border-bottom: 1px solid #f1f5f9; }
	.search-result-item:hover { background: #fff7ed; color: #ea580c; }

	.toc-list { display: flex; flex-direction: column; gap: 0.5rem; }
	.toc-item { color: #475569; text-decoration: none; font-size: 0.88rem; }
	.toc-item:hover { color: #ea580c; }
	.related-list { display: flex; flex-direction: column; gap: 0.75rem; }
	.related-item { color: #1e293b; text-decoration: none; font-size: 0.9rem; font-weight: 500; }
	.related-item:hover { color: #ea580c; }

	.site-footer-premium { background: #0f172a; color: #94a3b8; padding: 2rem 0; margin-top: 3rem; text-align: center; font-size: 0.85rem; }
</style>
