---
interface Props {
	title: string;
	description?: string;
	category?: string;
}

const { title, description = "Справочник по ремонту и обслуживанию автомобилей LADA", category = "Granta" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Лада Справка</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="logo">
					<span class="logo-icon">🛠</span>
					<span>Лада Справка</span>
				</a>
				<nav class="main-nav">
					<a href="/" class="nav-link">📁 Главная</a>
					<a href="/#topics" class="nav-link">📁 Все темы</a>
				</nav>
			</div>
		</header>

		<nav class="breadcrumbs" aria-label="Навигация">
			<div class="container">
				<a href="/">Главная</a>
				<span class="breadcrumb-sep">›</span>
				<span>{category}</span>
				<span class="breadcrumb-sep">›</span>
				<span class="breadcrumb-current">{title}</span>
			</div>
		</nav>

		<main class="site-main">
			<div class="container">
				<div class="article-layout">
					<article class="article-main">
						<slot />
					</article>

					<aside class="article-sidebar">
						<div class="sidebar-box">
							<h3>🔍 Поиск статей</h3>
							<input type="text" placeholder="Поиск по сайту..." class="search-input" />
						</div>
						<div class="sidebar-box">
							<h3>📖 Советы автолюбителям</h3>
							<p style="font-size: 0.9rem; color: #64748b;">Обслуживайте автомобиль вовремя по регламенту завода-изготовителя, чтобы избежать дорогостоящего ремонта.</p>
						</div>
					</aside>
				</div>
			</div>
		</main>

		<footer class="site-footer-premium">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-col">
						<div class="footer-brand">🛠 Лада Справка</div>
						<p class="footer-about">Lada (ВАЗ) — базы знаний, руководства по самостоятельному обслуживанию и ремонту популярной автотехники.</p>
					</div>
					<div class="footer-col">
						<h4>Навигация</h4>
						<ul>
							<li><a href="/">Главная страница</a></li>
							<li><a href="/#topics">Все материалы</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p>© 2026 Лада Справка. Все права защищены.</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--primary: #2563eb;
		--primary-hover: #1d4ed8;
		--bg: #f8fafc;
		--text: #1e293b;
		--card-bg: #ffffff;
		--border: #e2e8f0;
	}
	* { box-sizing: border-box; margin: 0; padding: 0; }
	body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
	.container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
	
	/* Header */
	.site-header { background: #ffffff; border-bottom: 1px solid var(--border); padding: 1rem 0; sticky: top; }
	.header-inner { display: flex; justify-content: space-between; align-items: center; }
	.logo { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.25rem; color: var(--text); text-decoration: none; }
	.main-nav { display: flex; gap: 1rem; }
	.nav-link { color: #64748b; text-decoration: none; font-weight: 500; font-size: 0.95rem; }
	.nav-link:hover { color: var(--primary); }

	/* Breadcrumbs */
	.breadcrumbs { background: #f1f5f9; padding: 0.75rem 0; font-size: 0.875rem; color: #64748b; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
	.breadcrumbs a { color: var(--primary); text-decoration: none; }
	.breadcrumb-sep { margin: 0 0.5rem; }
	.breadcrumb-current { color: #0f172a; font-weight: 500; }

	/* Layout Grid */
	.article-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2rem; }
	@media (max-width: 900px) {
		.article-layout { grid-template-columns: 1fr; }
	}

	/* Main Article Styles */
	.article-main { background: #fff; padding: 2rem; border-radius: 12px; border: 1px solid var(--border); }
	.article-main h1 { font-size: 2rem; line-height: 1.3; margin-bottom: 1.5rem; color: #0f172a; }
	.article-main h2 { font-size: 1.4rem; margin: 1.8rem 0 1rem 0; color: #1e293b; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.5rem; }
	.article-main p { margin-bottom: 1.2rem; font-size: 1.05rem; color: #334155; }
	.article-main ul, .article-main ol { margin: 1rem 0 1.5rem 1.5rem; color: #334155; }
	.article-main li { margin-bottom: 0.5rem; }
	
	/* Tables & Alerts */
	table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
	th, td { border: 1px solid var(--border); padding: 0.75rem; text-align: left; font-size: 0.95rem; }
	th { background: #f8fafc; font-weight: 600; }
	blockquote { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 1rem; margin: 1.5rem 0; border-radius: 4px; font-weight: 500; }
	
	/* Accordions / Details */
	details { background: #f8fafc; border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
	summary { font-weight: 600; cursor: pointer; color: var(--primary); }

	/* Sidebar */
	.sidebar-box { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; }
	.sidebar-box h3 { font-size: 1.1rem; margin-bottom: 1rem; color: #0f172a; }
	.search-input { width: 100%; padding: 0.6rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.9rem; }

	/* Footer */
	.site-footer-premium { background: #1e293b; color: #94a3b8; padding: 3rem 0 1.5rem 0; margin-top: 3rem; }
	.footer-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #334155; }
	.footer-brand { font-size: 1.2rem; font-weight: 700; color: #f1f5f9; margin-bottom: 0.5rem; }
	.footer-col h4 { color: #f1f5f9; margin-bottom: 1rem; }
	.footer-col ul { list-style: none; }
	.footer-col a { color: #94a3b8; text-decoration: none; }
	.footer-col a:hover { color: #60a5fa; }
	.footer-bottom { text-align: center; padding-top: 1.5rem; font-size: 0.85rem; }
</style>
